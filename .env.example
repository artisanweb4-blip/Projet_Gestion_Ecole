# Django Settings
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de données : 'sqlite3' en développement local, 'postgresql' en production
DB_ENGINE=sqlite3

# PostgreSQL (utilisé uniquement si DB_ENGINE=postgresql)
DB_NAME=school_db
DB_USER=school_user
DB_PASSWORD=school_password
DB_HOST=db
DB_PORT=5432

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
